  "joah": {
    "title": "生日以後",
    "artist": "JOAH\n詞曲：KAYON STUDIO KAYON\n製作：KAYON STUDIO\nKARBØN X GAIA ENTERTAINMENT · KAYON STUDIO",
    "cover": "《生日以後》 JOAH cover.jpg",
    "music": "《生日以後》JOAH.mp3",
    "lyricsStyle": "breathe",
    "lyrics": [
      {
        "time": 15,
        "text": "時間走得比想像還安靜"
      },
      {
        "time": 19,
        "text": "轉眼又來到熟悉日期"
      },
      {
        "time": 22,
        "text": "窗外的風還記得夏天"
      },
      {
        "time": 25,
        "text": "只是我們已經站在不同風景"
      },
      {
        "time": 29,
        "text": "偶爾想起那些小事情"
      },
      {
        "time": 32,
        "text": "會忍不住笑一下而已"
      },
      {
        "time": 35,
        "text": "有些答案不用說明"
      },
      {
        "time": 39,
        "text": "時間早就替我們收進心裡"
      },
      {
        "time": 42,
        "text": "如果願望真的會實現"
      },
      {
        "time": 46,
        "text": "我沒有想改變昨天"
      },
      {
        "time": 49,
        "text": "只希望你走過每一天"
      },
      {
        "time": 53,
        "text": "都比昨天幸福一點"
      },
      {
        "time": 56,
        "text": "今天就把天空留給煙火"
      },
      {
        "time": 60,
        "text": "把笑容留給陪著你的人"
      },
      {
        "time": 64,
        "text": "我把沒說出口的話"
      },
      {
        "time": 67,
        "text": "藏進風裡不打擾"
      },
      {
        "time": 70,
        "text": "願你愛的人也愛著你"
      },
      {
        "time": 74,
        "text": "願你走的路都有光明"
      },
      {
        "time": 76,
        "text": "如果想起我"
      },
      {
        "time": 78,
        "text": "不用回頭"
      },
      {
        "time": 81,
        "text": "記得快樂就好"
      },
      {
        "time": 85,
        "text": "世界一直不停改變著"
      },
      {
        "time": 89,
        "text": "我們也慢慢學會沉默"
      },
      {
        "time": 92,
        "text": "不是每段故事都有結果"
      },
      {
        "time": 95,
        "text": "卻都值得被溫柔記得"
      },
      {
        "time": 99,
        "text": "後來我終於明白了"
      },
      {
        "time": 103,
        "text": "有些名字不是忘了"
      },
      {
        "time": 106,
        "text": "只是放進心裡某個角落"
      },
      {
        "time": 109,
        "text": "偶爾想起 還是溫熱"
      },
      {
        "time": 113,
        "text": "謝謝那段陪伴我的日子"
      },
      {
        "time": 115,
        "text": "謝謝你曾經相信我"
      },
      {
        "time": 119,
        "text": "就算故事停在這裡"
      },
      {
        "time": 121,
        "text": "我依然相信"
      },
      {
        "time": 123,
        "text": "相遇從來沒有錯"
      },
      {
        "time": 126,
        "text": "今天就把星空留給今晚"
      },
      {
        "time": 130,
        "text": "把願望留給未來的人生"
      },
      {
        "time": 134,
        "text": "我把所有祝福"
      },
      {
        "time": 136,
        "text": "留在這首歌"
      },
      {
        "time": 140,
        "text": "願你一直勇敢地生活"
      },
      {
        "time": 144,
        "text": "願你一直相信值得"
      },
      {
        "time": 146,
        "text": "如果未來"
      },
      {
        "time": 148,
        "text": "我們還會相遇"
      },
      {
        "time": 150,
        "text": "希望那時候"
      },
      {
        "time": 153,
        "text": "我們都很好"
      },
      {
        "time": 158,
        "text": "今天以後"
      },
      {
        "time": 160,
        "text": "請一直幸福"
      },
      {
        "time": 9999,
        "text": "──────────────"
      },
      {
        "time": 9999,
        "text": "詞曲：KAYON STUDIO KAYON"
      },
      {
        "time": 9999,
        "text": "製作：KAYON STUDIO"
      },
      {
        "time": 9999,
        "text": "℗ © 2026 KARBØN X GAIA ENTERTAINMENT · KAYON STUDIO"
      }
    ]
  },
