  "oscar_insync": {
    "title": "合拍 In Sync",
    "artist": "KARBØN X GAIA ARTIST\n作詞/作曲/編曲/混音/母帶：KAYON STUDIO KAYON",
    "cover": "insync.jpg",
    "music": "insync.mp3",
    "lyrics": [
      {
        "time": 14,
        "text": "在日本 街頭 第一次 見面"
      },
      {
        "time": 17,
        "text": "相同的 興趣 聊到了 凌晨 三點"
      },
      {
        "time": 20,
        "text": "妳 當時 脆弱 是我 牽起 妳的 手"
      },
      {
        "time": 24,
        "text": "那是 我 唯一 不後悔 的 時候"
      },
      {
        "time": 27,
        "text": "一年半 三次 日本 回憶 變得很 深"
      },
      {
        "time": 34,
        "text": "四月 的 櫻花 真的 變得很 美"
      },
      {
        "time": 40,
        "text": "我 買了 戒指 認定了 娶妳 回家"
      },
      {
        "time": 44,
        "text": "我 為了 我們 親手 買了 一個 家"
      },
      {
        "time": 47,
        "text": "裝修 每一格 都是 照妳 喜歡 的 畫"
      },
      {
        "time": 51,
        "text": "結果 房子 快好了 妳 卻 要離開 掙扎"
      },
      {
        "time": 54,
        "text": "妳 說妳 累了 妳 轉身 走了"
      },
      {
        "time": 58,
        "text": "在這個 房間 我 真的 瘋了 It's crazy"
      },
      {
        "time": 66,
        "text": "對不起 我 以前 總是 愛 說妳"
      },
      {
        "time": 69,
        "text": "逼妳 學習 卻 忘了 關心 妳"
      },
      {
        "time": 72,
        "text": "妳 想我 哄妳 我 卻只會 怪妳"
      },
      {
        "time": 75,
        "text": "我 注重 未來 卻 忽略 妳的 現在"
      },
      {
        "time": 78,
        "text": "這是我 想要 挽回 的 節拍"
      },
      {
        "time": 81,
        "text": "把 那些 傷害 全部 都 撥開"
      },
      {
        "time": 85,
        "text": "這一次 我會 靜靜 陪在 妳 身邊"
      },
      {
        "time": 91,
        "text": "只要 妳 回來 才是 最 好的 狀態"
      },
      {
        "time": 98,
        "text": "這一次 我 絕對 不會 讓妳 走開"
      },
      {
        "time": 104,
        "text": "You're the only one"
      },
      {
        "time": 108,
        "text": "我 想起 妳 下班 等我 的 樣子"
      },
      {
        "time": 111,
        "text": "或是 突然 煮飯 拿到 公司 給我 的 樣子"
      },
      {
        "time": 115,
        "text": "雖然 只有 幾次 我 真的 很 開心"
      },
      {
        "time": 118,
        "text": "但我 總是 為了 生活 讓妳 傷心"
      },
      {
        "time": 122,
        "text": "後來 才 知道 妳 吵完架 都在 哭"
      },
      {
        "time": 129,
        "text": "把 心事 藏起來 讓我 像個 糊塗 的 豬"
      },
      {
        "time": 135,
        "text": "我 怪妳 沒主見 怪妳 不體諒"
      },
      {
        "time": 138,
        "text": "其實 是我 不尊重 讓 距離 變大"
      },
      {
        "time": 142,
        "text": "我們 的 頻率 以前 總是 對不上"
      },
      {
        "time": 145,
        "text": "但我 這次 想為了 妳 改變"
      },
      {
        "time": 150,
        "text": "那些 關心 的 視線 依然 重疊 著"
      },
      {
        "time": 153,
        "text": "這首 旋律 會 替我 證明 些 什麼"
      },
      {
        "time": 159,
        "text": "四月 二十二"
      },
      {
        "time": 161,
        "text": "我要 回到 我們 最初 的 東京"
      },
      {
        "time": 164,
        "text": "機票 買好了 我 還是 等不到 妳"
      },
      {
        "time": 167,
        "text": "如果 妳還在 聽"
      },
      {
        "time": 168,
        "text": "能不能 跟我 重新 對頻"
      },
      {
        "time": 170,
        "text": "這次 換我 陪妳 做回 妳自己"
      },
      {
        "time": 173,
        "text": "I'll be there"
      },
      {
        "time": 176,
        "text": "這是我 想要 挽回 的 節拍"
      },
      {
        "time": 179,
        "text": "把 那些 傷害 全部 都 撥開"
      },
      {
        "time": 183,
        "text": "這一次 我會 靜靜 陪在 妳 身邊"
      },
      {
        "time": 189,
        "text": "只要 妳 回來 才是 最 好的 狀態"
      },
      {
        "time": 196,
        "text": "這一次 我 絕對 不會 讓妳 走開"
      },
      {
        "time": 202,
        "text": "You're the only one"
      },
      {
        "time": 219,
        "text": "我 買好了 房子 但我 還是 想 娶妳 回家"
      },
      {
        "time": 231,
        "text": "四月 二十二 我 在 東京 Waiting for you"
      }
    ]
  },
  "shanghao": {
    "title": "上好的代誌",
    "artist": "KAYON STUDIO",
    "cover": "shanghao.jpg",
    "music": "上好的代誌人聲版.mp3",
    "lyrics": [
      {
        "time": 11.0,
        "text": "3",
        "type": "countdown"
      },
      {
        "time": 12.0,
        "text": "2",
        "type": "countdown"
      },
      {
        "time": 13.0,
        "text": "1",
        "type": "countdown"
      },
      {
        "time": 14.0,
        "text": "灶跤裡的菜瓜補啊  媽媽攏分袂清楚"
      },
      {
        "time": 19.43,
        "text": "阮也笑到袂記得"
      },
      {
        "time": 24.33,
        "text": "其實根本無要緊"
      },
      {
        "time": 27.76,
        "text": "琴房裡的黑白鍵"
      },
      {
        "time": 29.7,
        "text": "陪妳慢慢大漢"
      },
      {
        "time": 34.3,
        "text": "彼些時光妳都猶記得無"
      },
      {
        "time": 41.1,
        "text": "彼個坐佇琴前的囡仔"
      },
      {
        "time": 44.86,
        "text": "心內攏是溫柔"
      },
      {
        "time": 48.93,
        "text": "攏是妳藏著的代誌"
      },
      {
        "time": 55.96,
        "text": "細漢牽著阮的手"
      },
      {
        "time": 60.26,
        "text": "心肝仔囡仔"
      },
      {
        "time": 65.26,
        "text": "就按呢大漢了"
      },
      {
        "time": 69.5,
        "text": "後來的妳去山頂去海邊"
      },
      {
        "time": 76.06,
        "text": "去聽風的聲音 晒甲烏烏"
      },
      {
        "time": 84.3,
        "text": "阮看著妳"
      },
      {
        "time": 87.33,
        "text": "心肝又驕傲又毋甘"
      },
      {
        "time": 91.06,
        "text": "妳遐爾勇敢"
      },
      {
        "time": 93.16,
        "text": "阮才知影"
      },
      {
        "time": 98.2,
        "text": "有一寡路 愛家己行才會到"
      },
      {
        "time": 106.86,
        "text": "阮無愛管傷濟 只要妳的心"
      },
      {
        "time": 112.63,
        "text": "永遠是善良的 按呢就夠"
      },
      {
        "time": 120.46,
        "text": "希望妳尬伊 互相包容"
      },
      {
        "time": 128.0,
        "text": "鬥陣行落去 慢慢仔來"
      },
      {
        "time": 135.4,
        "text": "嫁出去前 阮陪著妳"
      },
      {
        "time": 142.23,
        "text": "嫁出去後 換伊疼妳"
      },
      {
        "time": 148.9,
        "text": "慢慢行 免著急 好日子本來就無愛趕"
      },
      {
        "time": 157.5,
        "text": "記得疼家己 也學會疼一個人"
      },
      {
        "time": 162.8,
        "text": "兩個人的路"
      },
      {
        "time": 165.9,
        "text": "慢慢行就會到"
      },
      {
        "time": 169.93,
        "text": "按呢就夠"
      },
      {
        "time": 173.53,
        "text": "♪  爸爸薩克斯風  ♪",
        "type": "instrumental"
      },
      {
        "time": 198.4,
        "text": "3",
        "type": "countdown"
      },
      {
        "time": 199.4,
        "text": "2",
        "type": "countdown"
      },
      {
        "time": 200.4,
        "text": "1",
        "type": "countdown"
      },
      {
        "time": 201.4,
        "text": "嫁出去前 阮陪著妳"
      },
      {
        "time": 207.9,
        "text": "嫁出去後 有人陪著妳"
      },
      {
        "time": 215.3,
        "text": "慢慢行 免著急"
      },
      {
        "time": 218.13,
        "text": "好日子本來就無愛趕"
      },
      {
        "time": 222.96,
        "text": "有時仔走袂去 也無要緊"
      },
      {
        "time": 225.93,
        "text": "有伊接住妳 就是上好的代誌"
      },
      {
        "time": 233.4,
        "text": "兩個人牽著手 阮就放心了"
      },
      {
        "time": 244.73,
        "text": "慢慢行 免急"
      },
      {
        "time": 247.63,
        "text": "若是攑袂起 就轉來"
      },
      {
        "time": 251.43,
        "text": "阮攏佇遮 等著妳"
      }
    ]
  },
